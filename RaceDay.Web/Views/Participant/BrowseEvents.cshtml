@model List<RaceDay.Web.DTOs.EventDto>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark">Upcoming Races & Events</h2>
    <p class="text-muted">Explore running, walking, and cycling events and sign up for categories.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info text-center py-4">No events available at the moment. Check back soon!</div>
        </div>
    }
    else
    {
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">@ev.EventType</span>
                            <small class="text-muted">@ev.Date.ToString("yyyy-MM-dd")</small>
                        </div>
                        <h4 class="card-title fw-bold">@ev.Name</h4>
                        <p class="card-text text-muted flex-grow-1">@ev.Description</p>
                        <ul class="list-unstyled mb-3">
                            <li>📍 <strong>Location:</strong> @ev.Location</li>
                            <li>🏁 <strong>Distance:</strong> @ev.Distance km</li>
                        </ul>
                        <a asp-action="EventDetails" asp-route-id="@ev.Id" class="btn btn-outline-primary w-100 fw-semibold">View Details & Enrol</a>
                    </div>
                </div>
            </div>
        }
    }
</div>