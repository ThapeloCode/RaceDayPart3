@model List<RaceDay.Web.DTOs.ParticipantResultDto>

@{
    ViewData["Title"] = "My Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">My Race Results</h2>
        <p class="text-muted mb-0">Track your finish times, rankings, and official event achievements.</p>
    </div>
    <a asp-action="BrowseEvents" class="btn btn-outline-primary btn-sm">&larr; Back to Events</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm rounded">
        <h4 class="alert-heading fw-bold">No Results Recorded Yet</h4>
        <p class="mb-0">Once an organiser finalizes times for an event you participated in, your results will appear here.</p>
    </div>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                    <th>Recorded Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model)
                {
                    <tr>
                        <td class="fw-bold">@res.EventName</td>
                        <td><span class="badge bg-secondary">@res.CategoryName</span></td>
                        <td><span class="badge bg-success font-monospace fs-6">@res.FinishTime</span></td>
                        <td>
                            @if (res.Position == 1)
                            {
                                <span class="badge bg-warning text-dark fw-bold">🥇 1st Place</span>
                            }
                            else if (res.Position == 2)
                            {
                                <span class="badge bg-light text-dark border fw-bold">🥈 2nd Place</span>
                            }
                            else if (res.Position == 3)
                            {
                                <span class="badge bg-secondary text-white fw-bold">🥉 3rd Place</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">#@res.Position</span>
                            }
                        </td>
                        <td>@res.RecordedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}