@{
    ViewData["Title"] = "Participant Profile";
}

<div class="container mt-4">
    <h2>My Participant Profile</h2>
    <hr />

    <div class="card shadow-sm p-4 mt-3">
        <h4>Account Overview</h4>
        <p class="text-muted">Welcome to your participant dashboard. From here, you can manage your race enrolments and view your performance results.</p>

        <div class="mt-4">
            <a asp-action="MyEnrolments" class="btn btn-primary me-2">View My Enrolments</a>
            <a asp-action="MyResults" class="btn btn-secondary">View My Results</a>
        </div>
    </div>
</div>