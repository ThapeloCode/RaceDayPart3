@model RaceDay.Web.DTOs.CreateEventDto

@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0 fw-bold">Create New Event</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateEvent" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label font-semibold">Event Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Soweto Marathon 2026" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide event details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Date" class="form-label">Event Date & Time</label>
                            <input asp-for="Date" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="EventType" class="form-label">Event Type</label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Running">Running</option>
                                <option value="Cycling">Cycling</option>
                                <option value="Walking">Walking</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Pretoria CBD" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Distance" class="form-label">Distance (km)</label>
                            <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                            <span asp-validation-for="Distance" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 font-semibold">Create Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}